<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>GoProBuddy</string>
	<key>CFBundleDisplayName</key>
	<string>GoProBuddy</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.goprobuddy</string>
	<key>CFBundleExecutable</key>
	<string>GoProBuddy</string>
	<key>CFBundleIconFile</key>
	<string>GoProBuddy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>VERSION</string>
	<key>CFBundleVersion</key>
	<string>VERSION</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Without this macOS terminates the app the moment it uses Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>GoProBuddy uses Bluetooth to find your GoPro and switch on its Wi-Fi.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>GoProBuddy talks to your GoPro over its Wi-Fi to list, download and preview your media.</string>
</dict>
</plist>
